local function createToggle(parent, text, posX, posY, configKey)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.45, 0, 0, 28)
    btn.Position = UDim2.new(posX, 0, 0, posY)
    btn.BackgroundColor3 = Config[configKey] and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(200, 50, 50)
    btn.BackgroundTransparency = 0.2
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = text .. (Config[configKey] and " [ON]" or " [OFF]")
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 11
    btn.Parent = parent
    
    btn.MouseButton1Click:Connect(function()
        Config[configKey] = not Config[configKey]
        btn.Text = text .. (Config[configKey] and " [ON]" or " [OFF]")
        btn.BackgroundColor3 = Config[configKey] and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(200, 50, 50)
        
        if configKey == "Chams" and not Config[configKey] then
            for _, objs in pairs(Chams_Objects) do if objs.Highlight then objs.Highlight:Destroy() end end
            Chams_Objects = {}
        end
    end)
end

